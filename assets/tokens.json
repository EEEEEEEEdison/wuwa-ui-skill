{
  "name": "wuwa-ui",
  "version": "2.0.0",
  "description": "Design tokens measured from the Wuthering Waves (鸣潮) official website, with a light theme and application states",
  "color": {
    "dark": {
      "bg": "#000000",
      "surface": "rgba(33, 33, 33, 0.55)",
      "surfaceSolid": "#1A1A1A",
      "surfaceRaised": "#2A2A2A",
      "onRaised": "#E1E1E1",
      "input": "#121212",
      "gold": "#C4AC7D",
      "goldBorder": "#C9AC67",
      "goldTitle": "#DAB67D",
      "goldText": "#C4AC7D",
      "onGold": "#16130E",
      "sand": "#D3CBB8",
      "silver": "#E1E1E1",
      "textMuted": "#989898",
      "borderLine": "#505050",
      "borderSoft": "#2E2E2E",
      "selected": "rgba(196, 172, 125, 0.12)",
      "ok": "#9DBB86",
      "warn": "#D9A55B",
      "danger": "#E07A6E"
    },
    "light": {
      "bg": "#F7F5F0",
      "surface": "rgba(255, 255, 255, 0.92)",
      "surfaceSolid": "#FFFFFF",
      "surfaceRaised": "#242220",
      "onRaised": "#FFFFFF",
      "input": "#FFFFFF",
      "gold": "#B5986A",
      "goldBorder": "#C4AC7D",
      "goldTitle": "#8E7340",
      "goldText": "#7A6233",
      "onGold": "#16130E",
      "sand": "#70685C",
      "silver": "#242220",
      "textMuted": "#6E665A",
      "borderLine": "#D2CAB8",
      "borderSoft": "#E7E2D7",
      "selected": "rgba(181, 152, 106, 0.16)",
      "ok": "#4E7A36",
      "warn": "#8C5B12",
      "danger": "#B0453A"
    }
  },
  "contrast": {
    "text": 4.5,
    "largeText": 3,
    "pairs": [
      ["silver", "bg"], ["sand", "bg"], ["textMuted", "bg"], ["goldText", "bg"],
      ["goldTitle", "bg", "large"], ["onGold", "gold"], ["ok", "bg"], ["warn", "bg"], ["danger", "bg"],
      ["silver", "surfaceSolid"], ["textMuted", "surfaceSolid"], ["onRaised", "surfaceRaised"]
    ]
  },
  "geometry": {
    "diagonalRadius": "16px 0",
    "diagonalRadiusSmall": "0 10px",
    "buttonRadius": "0 10px",
    "darkButtonRadius": "18px 0",
    "goldBorderWidth": "3px",
    "leftBarWidth": "4px",
    "indicatorHeight": "3px",
    "thinBorderWidth": "1px",
    "wpf": {
      "diagonalRadius": "16,0,16,0",
      "diagonalRadiusSmall": "0,10,0,10",
      "buttonRadius": "0,10,0,10",
      "darkButtonRadius": "18,0,18,0",
      "darkButtonBorder": "0,0,3,3"
    }
  },
  "space": [4, 8, 12, 16, 24, 32, 48],
  "type": {
    "eyebrow": { "size": 13, "minSize": 12, "letterSpacing": "0.2em", "case": "upper", "perPage": 1 },
    "pageTitle": { "size": 30, "weight": 700 },
    "sectionTitle": { "size": 17, "weight": 700 },
    "body": { "size": 14, "lineHeight": 1.6 },
    "caption": { "size": 13, "minSize": 13 }
  },
  "motion": {
    "hover": "200ms",
    "enter": "520ms",
    "sequenceMax": "1000ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "font": {
    "latin": "Novecentowide-Medium, Cinzel, Saira, 'Barlow Semi Condensed', sans-serif",
    "chinese": "'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', sans-serif",
    "windowsLatin": "Bahnschrift, Segoe UI Variable Display, Segoe UI",
    "windowsChinese": "Microsoft YaHei UI, Segoe UI"
  }
}
